# ==========================================
# CONFIGURACIÓN GENERAL DEL API GATEWAY
# ==========================================
PORT=3000
JWT_SECRET=tu_secreto_jwt_aqui

# URLs de los Microservicios (Ejecución Local / Desarrollo)
EMPLEADOS_URL=http://localhost:3001
NOMINA_URL=http://localhost:3002
RECLUTAMIENTO_URL=http://localhost:3003

# ==========================================
# SERVICIO DE EMPLEADOS (PostgreSQL)
# ==========================================
EMPLEADOS_PORT=3001
EMPLEADOS_DB_URL=postgres://usuario:password@localhost:5432/empleados_db

# ==========================================
# SERVICIO DE NÓMINA (PostgreSQL)
# ==========================================
NOMINA_PORT=3002
NOMINA_DB_URL=postgres://usuario:password@localhost:5432/nomina_db

# ==========================================
# SERVICIO DE RECLUTAMIENTO (MongoDB)
# ==========================================
RECLUTAMIENTO_PORT=3003
RECLUTAMIENTO_MONGO_URL=mongodb://localhost:27017/reclutamiento_db